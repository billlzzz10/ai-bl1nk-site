# AI Gateway Environment Variables
# Copy this file to .env and fill in your API keys

# OpenAI
OPENAI_KEY=sk-...

# Google Gemini
GEMINI_KEY=...

# Voyage AI
VOYAGE_KEY=...

# Cohere
COHERE_KEY=...

# Mistral AI
MISTRAL_KEY=...

# AWS Bedrock (requires all 3)
BEDROCK_KEY=...
BEDROCK_SECRET=...
BEDROCK_REGION=us-east-1

# xAI (Grok)
XAI_KEY=...

# ZAI (if you have)
ZAI_KEY=...

# OpenCode (if you have)
OPENCODE_KEY=...

# GitHub Models (Free tier for developers!)
GITHUB_TOKEN=github_pat_...

# Note: You don't need ALL keys to test
# The gateway will return proper errors for missing keys
# and use fallback providers when available
